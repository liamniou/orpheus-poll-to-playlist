# Orpheus Poll to Playlist - Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Orpheus Network Credentials
# =============================================================================

# Your Orpheus API key (User Settings → API Keys → Create new key)
ORPHEUS_API_KEY=your_api_key_here

# Session cookie for page scraping (Browser DevTools → Application → Cookies → session)
ORPHEUS_SESSION_COOKIE=your_session_cookie_here

# =============================================================================
# OPTIONAL - Application Settings
# =============================================================================

# Server host and port (defaults: 0.0.0.0:7575)
# APP_HOST=0.0.0.0
# APP_PORT=7575

# Cache TTL in minutes (default: 30)
# CACHE_TTL_MINUTES=30

# Download directory for torrent files (default: ./downloads)
# DOWNLOAD_DIR=./downloads

# =============================================================================
# OPTIONAL - qBittorrent Integration
# =============================================================================

# qBittorrent WebUI URL (e.g., http://localhost:8080)
QBIT_URL=

# qBittorrent credentials
QBIT_USER=
QBIT_PASSWORD=

# Category for downloaded torrents (default: orpheus)
# QBIT_CATEGORY=orpheus

# =============================================================================
# OPTIONAL - Navidrome Integration (for playlist creation)
# =============================================================================

# Navidrome server URL (e.g., http://localhost:4533)
NAVIDROME_URL=

# Navidrome credentials
NAVIDROME_USER=
# NAVIDROME_PASSWORD=

# Navidrome library ID (default: 1)
# NAVIDROME_LIBRARY_ID=1

# The music folder path AS NAVIDROME SEES IT inside its container.
# qBittorrent's save_path may differ (e.g., qBit saves to /downloads/music
# but Navidrome has that same share mounted at /music).
# Set this so targeted per-album scans point to the right location.
# NAVIDROME_MUSIC_FOLDER=/music
NAVIDROME_PASSWORD=

# =============================================================================
# OPTIONAL - Discord Notifications (for poll-notifier service)
# =============================================================================

# Discord webhook URL for poll change notifications
DISCORD_WEBHOOK_URL=

# Cron schedule for poll checks (default: "0 9 * * *" = 9:00 AM UTC daily)
# NOTIFIER_CRON_SCHEDULE=0 9 * * *

# Run poll check on container start (default: true)
# NOTIFIER_RUN_ON_START=true
